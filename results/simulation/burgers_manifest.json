{
  "experiment": "viscous_burgers",
  "replicates": 5,
  "domain": "periodic [0,1)",
  "time_interval": [
    0,
    0.5
  ],
  "nu": 0.01,
  "initial_condition": "sum_{k=1}^5 a_k sin(2pi k s)+b_k cos(2pi k s)",
